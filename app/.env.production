# Read by `vite build`. Public values only: all of this ends up in the bundle.

# The indexer, on the site's own address (deploy/caddy/Caddyfile).
VITE_API_URL=/indexer

# WalletConnect project id, from dashboard.reown.com. www.recurvemoney.xyz must be
# on the project's allowlist. Empty: injected wallets only.
VITE_WALLETCONNECT_ID=
