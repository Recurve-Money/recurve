# Which network src/lib/chain.ts selects. Defaults to mainnet (4663) when unset.
# Mainnet has no Recurve contracts yet, so a mainnet build lists the Recurve Fund
# as not live yet. Set this to testnet (46630) to point at the testnet fund.
VITE_NETWORK=mainnet

# RPC override for whichever network VITE_NETWORK selects. Unset uses that
# network's public endpoint. Point it at an RPC for the same chain id, not another.
VITE_RPC_URL=

# WalletConnect project id. Without it only injected wallets (MetaMask) work.
# The app's domain must be on the project's allowlist at dashboard.reown.com
# or the QR flow rejects the session.
VITE_WALLETCONNECT_ID=

# Deployed addresses, from recurve-protocol addresses/<chain id>.json. Unset means
# the selected network's entry in src/lib/chain.ts.
VITE_REGISTRY=
VITE_RECURVE_TOKEN=
VITE_DEPLOY_BLOCK=

# Indexer (api/) base URL, for the equity chart and risk stats.
VITE_API_URL=/indexer
