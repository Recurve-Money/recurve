# Railway injects DATABASE_URL automatically when a Postgres plugin is attached
DATABASE_URL=postgresql://user:pass@host:5432/railway

# A database on another host is reached over TLS and its certificate is checked.
# Railway's Postgres presents one Node cannot verify: uncomment to accept it.
# DATABASE_SSL_NO_VERIFY=true

# Robinhood Chain mainnet is the default. CHAIN_ID alone picks the network;
# RPC_URL only needs setting to override the built-in endpoint.
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Block the contracts went up; scanning from 0 wastes hours. Nothing Recurve is
# on mainnet yet, so 0 is a placeholder until a mainnet deploy gives us one.
DEPLOY_BLOCK=0

# Comma separated: slug:vault:governor:name. Empty until a mainnet deploy.
VAULTS=

# --- Robinhood Chain TESTNET (46630) ---------------------------------------
# The live fund runs here today, and these are TESTNET addresses: the same
# addresses on mainnet 4663 are unrelated third-party contracts. Never move
# them up under the mainnet heading.
# CHAIN_ID=46630
# RPC_URL=https://rpc.testnet.chain.robinhood.com
# DEPLOY_BLOCK=103992284
# VAULTS=main:0x235d0cE2Ca846495E9B9f18959A41f0625c0443D:0xe0e209799d57E6A95F72BdAe4b148cEf6f03da1a:Recurve Fund
# ---------------------------------------------------------------------------

# How often to poll for new blocks, and how many blocks per getLogs call.
# Both Robinhood RPCs cap eth_getLogs at 100,000 blocks per call (since October
# 2026; a wider range answers "Invalid parameters"), so 100000 is the largest
# chunk and turns the initial backfill from hours into minutes; the code
# default of 2000 is for RPCs that allow less.
POLL_MS=12000
LOG_CHUNK=100000

# Access-Control-Allow-Origin; unset = * (the API is read-only)
# CORS_ORIGIN=https://app.example.com

PORT=3000
